# ---- AgentArts 平台 ----
AGENT_RUN_PORT=8080
# 区域固定 cn-southwest-2（西南-贵阳一）
AGENTARTS_REGION=cn-southwest-2

# ---- 模型（MaaS OpenAI 兼容端点，密钥只存服务端环境变量）----
MAAS_BASE_URL=
MAAS_MODEL=
MAAS_API_KEY=

# ---- 持久化（云端必须设置；不设置则退化为本地内存，仅限离线测试）----
DATABASE_URL=

# ---- 行为开关 ----
# CAPLAB_OFFLINE=1 时使用本地 FastAPI 入口 + FakeLLM，禁止用于比赛演示
CAPLAB_OFFLINE=0
# 演示用 VIP 口令开关；生产保持 0，口令完全无效
CAPLAB_DEMO_VIP_SWITCH=0
