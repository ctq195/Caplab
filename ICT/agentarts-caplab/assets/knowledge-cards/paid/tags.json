{
  "本科去向": [
    {
      "tag": "继续升学",
      "definition": "国内推免/考研、境外升学、本校连续升学"
    },
    {
      "tag": "进入公共部门",
      "definition": "已录用为公务员、选调生或事业单位人员；备考过程不得写成结果"
    },
    {
      "tag": "直接就业",
      "definition": "必须填写首个已核验公司及岗位；未知不得猜测"
    },
    {
      "tag": "待业/备考",
      "definition": "尚未形成升学、就业或公共部门录用结果，必须保留状态日期"
    },
    {
      "tag": "待定/未知",
      "definition": "尚未发生、未披露或无法按本科节点分类"
    }
  ],
  "院校层次": [
    {
      "tag": "中国大陆正式类型",
      "definition": "985/211、双一流、公办本科、民办应用型等；记录时点"
    },
    {
      "tag": "海外院校类型",
      "definition": "公立/私立研究型等；不套用中国985/211"
    }
  ],
  "路径类型": [
    {
      "tag": "科研学术",
      "definition": "读研/博士、论文、数据集、评测、研究团队"
    },
    {
      "tag": "软件工程",
      "definition": "前端、后端、客户端、系统、架构、稳定性"
    },
    {
      "tag": "AI算法",
      "definition": "机器学习、多模态、LLM、Agent算法"
    },
    {
      "tag": "AI产品",
      "definition": "用户需求、PRD、原型、指标、跨团队"
    },
    {
      "tag": "测试开发",
      "definition": "自动化、质量保障、缺陷、评测集"
    },
    {
      "tag": "开源",
      "definition": "公开代码、Issue、PR、评审、维护"
    },
    {
      "tag": "技术创业",
      "definition": "产品、组织、市场、长期技术判断"
    }
  ],
  "证据状态": [
    {
      "tag": "已验证",
      "definition": "有可检查文件、结果或可信来源"
    },
    {
      "tag": "自述/转述",
      "definition": "由本人表达或机构转述，但未完成独立交叉验证"
    },
    {
      "tag": "推断",
      "definition": "由材料解释得出，需明确标注"
    },
    {
      "tag": "缺失",
      "definition": "关键字段没有信息"
    },
    {
      "tag": "冲突",
      "definition": "不同材料不一致，不能自动覆盖"
    }
  ],
  "证据产物": [
    {
      "tag": "代码与工程",
      "definition": "仓库、提交记录、测试、部署、性能数据"
    },
    {
      "tag": "研究",
      "definition": "论文复现、实验报告、数据卡、评测与bad case"
    },
    {
      "tag": "产品",
      "definition": "访谈原始记录、PRD、原型、指标与迭代"
    },
    {
      "tag": "协作",
      "definition": "Issue、会议纪要、评审意见、分工与复盘"
    }
  ],
  "时效规则": [
    {
      "tag": "30天复核",
      "definition": "动态招聘岗位超过30天先检查页面"
    },
    {
      "tag": "年度复核",
      "definition": "人物当前角色、公司与机构信息每年更新"
    }
  ],
  "输出规则": [
    {
      "tag": "案例带限制",
      "definition": "任何案例建议必须同时返回不可复制条件"
    },
    {
      "tag": "任务可验收",
      "definition": "任务必须含产物、截止时间和验收标准"
    }
  ],
  "不可复制条件": [
    {
      "tag": "重大历史事件",
      "definition": "疫情、战争、金融危机、重大政策冲击等改变机会结构的事件；必须解释事件如何影响该案例。"
    },
    {
      "tag": "技术史窗口",
      "definition": "某项技术范式、标准或基础设施处于早期转折，后进入者无法复刻首创位置。"
    },
    {
      "tag": "技术浪潮",
      "definition": "AI、移动互联网等快速扩张阶段带来的岗位、资本和传播红利。"
    },
    {
      "tag": "产业周期",
      "definition": "行业景气、供需、融资或竞争格局处于特定周期。"
    },
    {
      "tag": "招聘年代",
      "definition": "特定毕业年份的HC、学历门槛、岗位结构和面试环境。"
    },
    {
      "tag": "制度与政策",
      "definition": "推免、选调、招录、合作办学、人才政策等资格与窗口。"
    },
    {
      "tag": "教育制度年代",
      "definition": "历史培养制度、学科设置或学历结构与当前不同。"
    },
    {
      "tag": "区域政策",
      "definition": "园区、城市、补贴、落户及地方产业政策。"
    },
    {
      "tag": "平台资源",
      "definition": "院校、实验室、导师、企业、竞赛训练和国际项目资源。"
    },
    {
      "tag": "资本与组织",
      "definition": "资金、算力、核心团队、管理层授权和组织承压能力。"
    },
    {
      "tag": "经济条件",
      "definition": "家庭预算、机会成本、留学与迁移成本。"
    },
    {
      "tag": "个人稀缺性",
      "definition": "长期积累、极端投入、天赋或风险承受力等不应设为默认条件。"
    },
    {
      "tag": "回顾偏差",
      "definition": "成功后访谈、机构宣传或个人回忆可能重构早期因果。"
    },
    {
      "tag": "样本选择",
      "definition": "优秀毕业生、成功校友和公开报道不代表总体成功率。"
    }
  ],
  "治理状态": [
    {
      "tag": "STRUCTURE_ONLY",
      "definition": "仅有字段和模板，不能用于具体资格或结果判断"
    },
    {
      "tag": "UNVERIFIED_TEMPLATE",
      "definition": "已有产品模板，但未绑定具体实例或官方来源"
    },
    {
      "tag": "PENDING_OFFICIAL_VERIFY",
      "definition": "已定位动态对象，等待官方来源、周期或版本复核"
    },
    {
      "tag": "ACTIVE_VERIFIED",
      "definition": "来源、适用对象、周期与核验日期完整，可在边界内使用"
    },
    {
      "tag": "EXPIRED",
      "definition": "超过适用期或出现新版本，不得继续驱动判断"
    },
    {
      "tag": "CONFLICTED",
      "definition": "证据或来源相互冲突，需保留冲突并人工复核"
    },
    {
      "tag": "USER_VALIDATION_PENDING",
      "definition": "产品规划假设尚未经过真实用户任务验证"
    }
  ]
}
