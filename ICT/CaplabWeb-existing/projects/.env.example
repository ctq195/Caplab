# CapLab 模型配置（DeepSeek V4 Flash · OpenAI 兼容接口）
# 复制本文件为 .env.local 并填入你在对应平台获取的 API Key，切勿提交真实密钥到仓库

DEEPSEEK_API_KEY=your_api_key_here

# DeepSeek 官方 API 模型名：deepseek-flash（V4 Flash）或 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# Base URL 按你使用的平台选择（OpenAI 兼容地址，不含 /chat/completions）：
# DeepSeek 官方：https://api.deepseek.com
# 华为云 MaaS：https://api.modelarts-maas.com/openai/v1
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
# 火山方舟：https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 服务端 MOSS 流式语音合成
MOSS_API_KEY=
